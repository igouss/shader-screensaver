#!/bin/bash

# Manage the shader screensaver's collection (~/.config/shader-screensaver/shaders,
# a symlink into ~/Projects/shader-screensaver). Adds and removals are committed
# to git automatically.

set -euo pipefail
shopt -s nullglob

dir="${XDG_CONFIG_HOME:-$HOME/.config}/shader-screensaver/shaders"
state="${XDG_STATE_HOME:-$HOME/.local/state}/shader-screensaver"
bin="$HOME/.local/bin/shader-screensaver"
repo="$(dirname "$(readlink -f "$0")")/.."
words="$repo/names"
settings="$repo/settings.conf"

usage() {
  cat >&2 <<EOF
usage: screensaver-shaders <command>
  add [name]           save a shader from stdin, or from the clipboard when stdin is a terminal;
                       a missing or taken name is replaced by a random two-word one
  remove <name|last>   delete a shader (last = the one shown most recently)
  preview [name|last]  show a shader fullscreen now (random when no name); any key exits
  check <file> [png]   compile a shader offscreen; with png, also render a thumbnail
                       and report brightness, motion and cost
  last                 name of the shader shown most recently
  history [n]          when each of the last n (default 20) shaders was shown
  list                 the collection, with when each was last shown (or "new")
  pick                 the order the next screensaver run will try shaders in
  cycle                show every shader in turn, cycle_seconds (settings.conf) each:
                       space pause, d delete, 1-9 seconds (0 = 10), ←/→ previous/next, q quit
EOF
  exit 1
}

die() {
  echo "screensaver-shaders: $*" >&2
  exit 1
}

name_of() {
  local base=${1##*/}
  echo "${base%.*}"
}

last_name() {
  [[ -s $state/current ]] || die "no shader has been shown yet"
  name_of "$(<"$state/current")"
}

# Accepts a collection name (with or without extension), "last", or a path.
resolve() {
  local want=$1 f
  [[ $want == last ]] && want=$(last_name)
  for f in "$want" "$dir/$want" "$dir/$want.frag" "$dir/$want.glsl"; do
    [[ -f $f ]] && { echo "$f"; return; }
  done
  die "no shader named '$1' in $dir"
}

taken() {
  [[ -e $dir/$1.frag || -e $dir/$1.glsl ]]
}

# A value from settings.conf, or $2 when it isn't set there.
setting() {
  local value
  value=$(sed -nE "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*([^#[:space:]]+).*/\1/p" "$settings" 2>/dev/null | tail -n1)
  echo "${value:-$2}"
}

# An unused adjective-noun name from the word lists in names/.
random_name() {
  local name i
  for ((i = 0; i < 200; i++)); do
    name=$(shuf -n1 "$words/adjectives")-$(shuf -n1 "$words/nouns")
    taken "$name" || { echo "$name"; return; }
  done
  die "no unused random name found in $words"
}

# shown[name] ="YYYY-MM-DD HH:MM:SS" it was last shown, from the run log.
declare -A shown=()
load_shown() {
  [[ -f $state/log ]] || return 0
  local name when
  while IFS=$'\t' read -r name when; do shown[$name]=$when; done < <(
    sed -nE 's|^([0-9-]+ [0-9:]+) showing .*/([^/]+)\.[a-z]+ \(.*\)$|\2\t\1|p' "$state/log")
}

# Playlist, best first: never-shown shaders (shuffled), then the half of the
# collection shown longest ago (shuffled), then the rest oldest-first as
# fallbacks. A shader can't come back until about half the others have played.
pick() {
  load_shown
  local f name unseen=() seen=() sorted=()
  for f in "$dir"/*.frag "$dir"/*.glsl; do
    name=$(name_of "$f")
    if [[ -n ${shown[$name]:-} ]]; then seen+=("${shown[$name]}"$'\t'"$f"); else unseen+=("$f"); fi
  done

  if ((${#unseen[@]})); then printf '%s\n' "${unseen[@]}" | shuf; fi
  if ((${#seen[@]})); then
    mapfile -t sorted < <(printf '%s\n' "${seen[@]}" | sort | cut -f2-)
    local half=$(((${#sorted[@]} + 1) / 2))
    printf '%s\n' "${sorted[@]:0:half}" | shuf
    if ((${#sorted[@]} > half)); then printf '%s\n' "${sorted[@]:half}"; fi
  fi
}

# Commits changes to the collection when it lives in a git repo.
commit() {
  git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || return 0
  git -C "$dir" add -A .
  if git -C "$dir" diff --cached --quiet -- .; then return 0; fi
  if git -C "$dir" commit -q -m "$1" -- .; then
    echo "Committed: $1"
  else
    echo "screensaver-shaders: git commit failed; the change is saved but not committed" >&2
  fi
}

# Deletes a shader file and commits the removal.
remove_shader() {
  local name
  name=$(name_of "$1")
  rm -- "$1"
  echo "Removed $name"
  commit "Remove shader $name"
}

case "${1:-}" in
add)
  name=$(tr '[:upper:]' '[:lower:]' <<<"${2:-}" | sed -E 's/\.(frag|glsl)$//; s/[^a-z0-9]+/-/g; s/^-+|-+$//g')
  if [[ -z $name ]]; then
    name=$(random_name)
  elif taken "$name"; then
    new=$(random_name)
    echo "'$name' is taken; using '$new'"
    name=$new
  fi
  target="$dir/$name.frag"

  tmp=$(mktemp --suffix=.frag)
  trap 'rm -f "$tmp"' EXIT
  if [[ -t 0 ]]; then wl-paste --no-newline >"$tmp"; else cat >"$tmp"; fi
  [[ -s $tmp ]] || die "nothing to add (clipboard/stdin is empty)"

  timeout 60 "$bin" --check "$tmp" >/dev/null
  mkdir -p "$dir"
  install -m 644 "$tmp" "$target"
  echo "Added $name"
  commit "Add shader $name"
  ;;
remove)
  [[ -n ${2:-} ]] || usage
  file=$(resolve "$2")
  remove_shader "$file"
  ;;
preview)
  if [[ -n ${2:-} ]]; then target=$(resolve "$2"); else target=$dir; fi
  exec "$bin" --shader "$target"
  ;;
check)
  [[ -n ${2:-} ]] || usage
  exec timeout 60 "$bin" --check "$2" ${3:+--thumb "$3"}
  ;;
last)
  last_name
  ;;
history)
  [[ -f $state/log ]] || die "no shader has been shown yet"
  grep -h ' showing ' "$state/log" | tail -n "${2:-20}" | sed -E 's| showing .*/([^/]+)\.[a-z]+ \((.*) format\)$|  \1  (\2)|'
  ;;
list)
  load_shown
  for f in "$dir"/*.frag "$dir"/*.glsl; do
    name=$(name_of "$f")
    printf '%-24s %s\n' "$name" "${shown[$name]:-new}"
  done
  ;;
pick)
  pick
  ;;
cycle)
  seconds=$(setting cycle_seconds 3)
  mapfile -t playlist < <(pick)
  ((${#playlist[@]})) || die "the collection is empty"
  args=()
  for f in "${playlist[@]}"; do args+=(--shader "$f"); done
  echo "Cycling ${#playlist[@]} shaders, ${seconds}s each."
  echo "Keys: space pause/resume, d delete, 1-9 seconds per shader (0 = 10), ←/→ previous/next, q or Esc quit."

  # One notification, updated in place, names what's on screen.
  note=0
  notify() {
    note=$(omarchy-notification-send -p -r "$note" --app-name shader-screensaver "$1" "$2" 2>/dev/null || echo 0)
  }

  mkdir -p "$state"
  deleted=0 deleted_note=""
  while IFS=$'\t' read -r event a b c; do
    case $event in
    show)
      echo "  $a/$b  $(name_of "$c")"
      notify "$(name_of "$c")" "${deleted_note}$a of $b · space pause · d delete"
      deleted_note=""
      ;;
    paused) notify "$(name_of "$a") — paused" "space resumes · d delete" ;;
    resumed) notify "$(name_of "$a")" "resumed" ;;
    interval) notify "$(name_of "$b")" "${a}s per shader" ;;
    delete)
      remove_shader "$a" >/dev/null
      deleted=$((deleted + 1))
      deleted_note="deleted $(name_of "$a") · "
      echo "  deleted $(name_of "$a")"
      ;;
    esac
  done < <("$bin" --cycle "$seconds" --scale "$(setting render_scale 1.0)" --log "$state/log" "${args[@]}")
  if ! wait "$!"; then
    echo "screensaver-shaders: the viewer failed; see $state/log" >&2
  fi

  if ((deleted)) && git -C "$dir" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    git -C "$dir" push -q && echo "Pushed $deleted deletion(s)"
  fi
  ;;
*)
  usage
  ;;
esac
