#!/bin/bash

# Manage the shader screensaver's collection (~/.config/shader-screensaver/shaders,
# a symlink into ~/Projects/shader-screensaver). Adds and removals are committed
# to git automatically.

set -euo pipefail
shopt -s nullglob

dir="${XDG_CONFIG_HOME:-$HOME/.config}/shader-screensaver/shaders"
state="${XDG_STATE_HOME:-$HOME/.local/state}/shader-screensaver"
bin="$HOME/.local/bin/shader-screensaver"
repo="$(dirname "$(readlink -f "$0")")/.."
words="$repo/names"
settings="$repo/settings.conf"
qt_cache="${XDG_CACHE_HOME:-$HOME/.cache}/shader-screensaver/qt"
qsb=/usr/lib/qt6/bin/qsb

usage() {
  cat >&2 <<EOF
usage: screensaver-shaders <command>
  add [name]           save a shader from stdin, or from the clipboard when stdin is a terminal;
                       a missing or taken name is replaced by a random two-word one
  remove <name|last>   delete a shader (last = the one shown most recently)
  preview [name|last]  show a shader fullscreen now (random when no name); any key exits
  check <file> [png]   compile a shader offscreen; with png, also render a thumbnail
                       and report brightness, motion and cost
  last                 name of the shader shown most recently
  list                 the collection's shader names
  qt                   compile the collection for the lock screen (Qt ShaderEffect .qsb
                       files in ~/.cache/shader-screensaver/qt); only changed shaders rebuild
  lock                 the compiled shader the lock screen shows next (logged as shown),
                       with its lock_* settings, tab-separated
  cycle                show every shader in turn, cycle_seconds (settings.conf) each:
                       space pause, d delete, 1-9 seconds (0 = 10), ←/→ previous/next, q quit
EOF
  exit 1
}

die() {
  echo "screensaver-shaders: $*" >&2
  exit 1
}

name_of() {
  local base=${1##*/}
  echo "${base%.*}"
}

last_name() {
  [[ -s $state/current ]] || die "no shader has been shown yet"
  name_of "$(<"$state/current")"
}

# Accepts a collection name (with or without extension), "last", or a path.
resolve() {
  local want=$1 f
  [[ $want == last ]] && want=$(last_name)
  for f in "$want" "$dir/$want" "$dir/$want.frag" "$dir/$want.glsl"; do
    [[ -f $f ]] && { echo "$f"; return; }
  done
  die "no shader named '$1' in $dir"
}

taken() {
  [[ -e $dir/$1.frag || -e $dir/$1.glsl ]]
}

# A value from settings.conf, or $2 when it isn't set there.
setting() {
  local value
  value=$(sed -nE "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*([^#[:space:]]+).*/\1/p" "$settings" 2>/dev/null | tail -n1)
  echo "${value:-$2}"
}

# An unused adjective-noun name from the word lists in names/.
random_name() {
  local name i
  for ((i = 0; i < 200; i++)); do
    name=$(shuf -n1 "$words/adjectives")-$(shuf -n1 "$words/nouns")
    taken "$name" || { echo "$name"; return; }
  done
  die "no unused random name found in $words"
}

# The rotation's run log, where a show outside a rotation run is logged so the
# rotation moves past it; empty without screensaver-rotation.
rotation_log() {
  screensaver-rotation log-path 2>/dev/null || true
}

# The collection's shaders in the order the rotation would show them
# (screensaver-rotation owns the rotation), or shuffled when it isn't
# installed or doesn't list them.
shader_order() {
  local order
  order=$(screensaver-rotation pick --runner shaders 2>/dev/null | cut -f2-) || true
  if [[ -n $order ]]; then
    printf '%s\n' "$order"
  else
    printf '%s\n' "$dir"/*.frag "$dir"/*.glsl | shuf
  fi
}

# Brings the lock screen's compiled copies up to date: rebuilds the ones older
# than their shader, drops the ones whose shader is gone. A shader that can't
# run in a ShaderEffect gets an empty .qsb, so it isn't retried until it changes.
build_qt() {
  [[ -x $qsb ]] || die "$qsb is missing (pacman -S qt6-shadertools)"
  mkdir -p "$qt_cache"
  local f name out tmp failed=0 built=0
  for f in "$dir"/*.frag "$dir"/*.glsl; do
    name=$(name_of "$f")
    out="$qt_cache/$name.qsb"
    [[ -e $out && $out -nt $f && $out -nt $bin ]] && continue
    tmp=$(mktemp "$qt_cache/.$name.XXXXXX")
    if "$bin" --qt "$f" >"$tmp.frag" 2>"$tmp.err" &&
      "$qsb" --glsl "300 es,330" -o "$tmp" "$tmp.frag" >>"$tmp.err" 2>&1; then
      mv "$tmp" "$out"
      built=$((built + 1))
    else
      echo "screensaver-shaders: $name can't run on the lock screen: $(grep -m1 -i error "$tmp.err")" >&2
      : >"$out"
      rm -f "$tmp"
      failed=$((failed + 1))
    fi
    rm -f "$tmp.frag" "$tmp.err"
  done
  for out in "$qt_cache"/*.qsb; do
    name=$(name_of "$out")
    [[ -e $dir/$name.frag || -e $dir/$name.glsl ]] || rm -f "$out"
  done
  ((built + failed == 0)) || echo "Compiled $built shader(s) for the lock screen; $failed can't run there." >&2
}

# Commits changes to the collection when it lives in a git repo.
commit() {
  git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || return 0
  git -C "$dir" add -A .
  if git -C "$dir" diff --cached --quiet -- .; then return 0; fi
  if git -C "$dir" commit -q -m "$1" -- .; then
    echo "Committed: $1"
  else
    echo "screensaver-shaders: git commit failed; the change is saved but not committed" >&2
  fi
}

# Deletes a shader file and commits the removal.
remove_shader() {
  local name
  name=$(name_of "$1")
  rm -- "$1"
  echo "Removed $name"
  commit "Remove shader $name"
}

case "${1:-}" in
add)
  name=$(tr '[:upper:]' '[:lower:]' <<<"${2:-}" | sed -E 's/\.(frag|glsl)$//; s/[^a-z0-9]+/-/g; s/^-+|-+$//g')
  if [[ -z $name ]]; then
    name=$(random_name)
  elif taken "$name"; then
    new=$(random_name)
    echo "'$name' is taken; using '$new'"
    name=$new
  fi
  target="$dir/$name.frag"

  tmp=$(mktemp --suffix=.frag)
  trap 'rm -f "$tmp"' EXIT
  if [[ -t 0 ]]; then wl-paste --no-newline >"$tmp"; else cat >"$tmp"; fi
  [[ -s $tmp ]] || die "nothing to add (clipboard/stdin is empty)"

  timeout 60 "$bin" --check "$tmp" >/dev/null
  mkdir -p "$dir"
  install -m 644 "$tmp" "$target"
  echo "Added $name"
  commit "Add shader $name"
  ;;
remove)
  [[ -n ${2:-} ]] || usage
  file=$(resolve "$2")
  remove_shader "$file"
  ;;
preview)
  if [[ -n ${2:-} ]]; then target=$(resolve "$2"); else target=$dir; fi
  exec "$bin" --shader "$target"
  ;;
check)
  [[ -n ${2:-} ]] || usage
  exec timeout 60 "$bin" --check "$2" ${3:+--thumb "$3"}
  ;;
last)
  last_name
  ;;
list)
  for f in "$dir"/*.frag "$dir"/*.glsl; do name_of "$f"; done
  ;;
qt)
  build_qt
  ;;
lock)
  build_qt 2>/dev/null
  while IFS= read -r f; do
    out="$qt_cache/$(name_of "$f").qsb"
    [[ -s $out ]] || continue
    # Counts as shown, so the rotation moves past it too.
    log=$(rotation_log)
    if [[ -n $log ]]; then
      mkdir -p "${log%/*}"
      printf '%s showing %s (lock format)\n' "$(date '+%F %T')" "$f" >>"$log"
    fi
    # One line for the lock screen: shader, render scale, frame-rate cap and
    # seconds before the display turns off, tab-separated.
    printf '%s\t%s\t%s\t%s\n' "$out" "$(setting lock_render_scale 0.5)" \
      "$(setting max_fps 30)" "$(setting lock_blank_seconds 300)"
    exit 0
  done < <(shader_order)
  die "no shader in $dir runs on the lock screen"
  ;;
cycle)
  seconds=$(setting cycle_seconds 3)
  mapfile -t playlist < <(shader_order)
  ((${#playlist[@]})) || die "the collection is empty"
  args=()
  for f in "${playlist[@]}"; do args+=(--shader "$f"); done
  echo "Cycling ${#playlist[@]} shaders, ${seconds}s each."
  echo "Keys: space pause/resume, d delete, 1-9 seconds per shader (0 = 10), ←/→ previous/next, q or Esc quit."

  # One notification, updated in place, names what's on screen.
  note=0
  notify() {
    note=$(omarchy-notification-send -p -r "$note" --app-name shader-screensaver "$1" "$2" 2>/dev/null || echo 0)
  }

  # The shaders cycled through count as shown, so the rotation moves past them.
  log=$(rotation_log) log_args=()
  if [[ -n $log ]]; then
    mkdir -p "${log%/*}"
    log_args=(--log "$log")
  fi
  deleted=0 deleted_note=""
  while IFS=$'\t' read -r event a b c; do
    case $event in
    show)
      echo "  $a/$b  $(name_of "$c")"
      notify "$(name_of "$c")" "${deleted_note}$a of $b · space pause · d delete"
      deleted_note=""
      ;;
    paused) notify "$(name_of "$a") — paused" "space resumes · d delete" ;;
    resumed) notify "$(name_of "$a")" "resumed" ;;
    interval) notify "$(name_of "$b")" "${a}s per shader" ;;
    delete)
      remove_shader "$a" >/dev/null
      deleted=$((deleted + 1))
      deleted_note="deleted $(name_of "$a") · "
      echo "  deleted $(name_of "$a")"
      ;;
    esac
  done < <("$bin" --cycle "$seconds" --scale "$(setting render_scale 1.0)" --max-fps "$(setting max_fps 0)" \
    "${log_args[@]}" "${args[@]}")
  if ! wait "$!"; then
    echo "screensaver-shaders: the viewer failed${log:+; see $log}" >&2
  fi

  if ((deleted)) && git -C "$dir" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    git -C "$dir" push -q && echo "Pushed $deleted deletion(s)"
  fi
  ;;
*)
  usage
  ;;
esac
